# EmailJS credentials for the contact form. Copy to `.env` and fill in.
# Dashboard: https://dashboard.emailjs.com
#
# The public key is meant to be shipped in the client bundle — restrict usage
# under Account > Security by allow-listing the portfolio's domain.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
